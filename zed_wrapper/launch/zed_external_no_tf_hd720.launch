<launch>
    <!-- Camera Model and Name -->
    <arg name="camera_name"           default="zed_ext" /> <!-- The name you want -->
    <arg name="camera_model"          default="zed" /> <!-- 'zed' or 'zedm' or 'zed2' -->
    <arg name="node_name"             default="zed_node" />

    <!-- Load SVO file -->
    <arg name="svo_file"              default="" /><!-- <arg name="svo_file" default="path/to/svo/file.svo"> -->
    <!-- Remote stream -->
    <arg name="stream"                default="" /> <!-- <arg name="stream" default="<ip_address>:<port>"> -->

    <!-- Base frame -->
    <arg name="base_frame"            default="base_link_x" />

    <!-- Publish ZED urdf -->
    <arg name="publish_urdf"          default="false" />

    <!-- 
        zed1 outside: 19976    (serial_number) top of the vehicle, center
        zed2 inside:  29674938 (serial_number) driver monitoring
    -->
    <arg name="serial_number"         default="19976" />
    <!--
    '0': HD2K, '1': HD1080, '2': HD720, '3': VGA
    -->
    <arg name="resolution"         default="2" />
    <arg name="grab_frame_rate" default="60" /> <!-- 20 Hz -->
    <arg name="pub_frame_rate"  default="20" /> <!-- 20 Hz -->
    <arg name="publish_tf"            default="false" />
    <arg name="gpu_id"                default="-1" />

    <!-- Position respect to base frame (i.e. "base_link) -->
    <arg name="cam_pos_x"             default="0.0" />
    <arg name="cam_pos_y"             default="0.0" />
    <arg name="cam_pos_z"             default="0.0" />

    <!-- Orientation respect to base frame (i.e. "base_link) -->
    <arg name="cam_roll"              default="0.0" />
    <arg name="cam_pitch"             default="0.0" />
    <arg name="cam_yaw"               default="0.0" />

    <node name="$(arg node_name)" pkg="zed_wrapper" type="zed_wrapper_node" output="screen" required="true"><!-- launch-prefix="valgrind" -->
        <rosparam file="$(find zed_wrapper)/params/$(arg camera_model).yaml" command="load" />

        <!-- Camera name -->
        <param name="general/camera_name"               value="$(arg camera_name)" />

        <!-- Base frame -->
        <param name="general/base_frame"                value="$(arg base_frame)" />

        <!-- SVO file path -->
        <param name="svo_file"                          value="$(arg svo_file)" />

        <!-- Remote stream -->
        <param name="stream"                            value="$(arg stream)" />

        <!-- Camera ID -->
        <param name="general/serial_number"              value="$(arg serial_number)" />

        <!-- resolution -->
        <param name="general/resolution"             value="$(arg resolution)" />

        <!-- GPU ID -->
        <param name="general/gpu_id"                    value="$(arg gpu_id)" />

        <param name="general/grab_frame_rate"            value="$(arg grab_frame_rate)" />
        <param name="pub_frame_rate"                     value="$(arg pub_frame_rate)" />

        <!-- Disable TF publishing -->
        <param name="pos_tracking/publish_tf"            value="false" />
        <param name="pos_tracking/publish_map_tf"        value="false" />
        <param name="mapping/mapping_enabled"            value="false" />

    </node>
</launch>
